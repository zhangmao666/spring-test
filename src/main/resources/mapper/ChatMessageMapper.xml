<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboottest.modules.ai.mapper.ChatMessageMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.example.springboottest.modules.ai.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="thought" property="thought"/>
        <result column="thinking_time" property="thinkingTime"/>
        <result column="used_web_search" property="usedWebSearch"/>
        <result column="used_deep_thinking" property="usedDeepThinking"/>
        <result column="search_query" property="searchQuery"/>
        <result column="search_status" property="searchStatus"/>
        <result column="source_payload" property="sourcePayload"/>
        <result column="created_at" property="createdAt"/>
        <result column="message_index" property="messageIndex"/>
    </resultMap>

    <!-- 根据会话ID查询所有消息，按序号升序 -->
    <select id="findByConversationIdOrderByIndex" resultMap="BaseResultMap">
        SELECT * FROM chat_messages
        WHERE conversation_id = #{conversationId}
        ORDER BY message_index ASC
    </select>

    <!-- 插入消息 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_messages (
            conversation_id, role, content, thought, thinking_time,
            used_web_search, used_deep_thinking, search_query, search_status,
            source_payload, message_index
        ) VALUES (
            #{conversationId}, #{role}, #{content}, #{thought}, #{thinkingTime},
            #{usedWebSearch}, #{usedDeepThinking}, #{searchQuery}, #{searchStatus},
            #{sourcePayload}, #{messageIndex}
        )
    </insert>

    <!-- 删除某会话的所有消息 -->
    <delete id="deleteByConversationId">
        DELETE FROM chat_messages
        WHERE conversation_id = #{conversationId}
    </delete>

    <!-- 统计某会话的消息数 -->
    <select id="countByConversationId" resultType="int">
        SELECT COUNT(1) FROM chat_messages
        WHERE conversation_id = #{conversationId}
    </select>

</mapper>
